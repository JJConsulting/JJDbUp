<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>JJConsulting.DbUp</PackageId>
    <Authors>JJConsulting</Authors>
    <Description>SQL Server migrations and versionable database objects using DbUp and DbUpX.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/JJConsulting/JJDbUp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

	<ItemGroup>

		<PackageReference Include="dbup-sqlserver" />

		<PackageReference Include="DbUpX.Reborn" />

		<PackageReference Include="Microsoft.Data.SqlClient" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />

	</ItemGroup>

	<ItemGroup>
	  <Content Include="..\..\README.md" Pack="true" PackagePath="/">
	    <Link>README.md</Link>
	  </Content>
	</ItemGroup>


</Project>
