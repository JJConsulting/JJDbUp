<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>jjdbup</ToolCommandName>
    <PackageId>JJConsulting.DbUp.Cli</PackageId>
    <Authors>JJConsulting</Authors>
    <Description>Local and CI SQL Server migration commands using JJConsulting.DbUp.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/JJConsulting/JJMigrations</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../JJConsulting.DbUp/JJConsulting.DbUp.csproj" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="Spectre.Console.Cli" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <InternalsVisibleTo Include="JJConsulting.DbUp.Tests" />
    <Content Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
